# Names only - never commit real values. Copy to .env for local runs.
APP_ENV=development                 # production refuses to start with the default SECRET_KEY
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/app.db
POLICY_PATH=policy/privacy_policy_v1.yaml
PROMPTS_DIR=prompts/v1

# LLM (the mock LLM needs no key and is the default)
LLM_PROVIDER=mock                   # mock | anthropic
FORCE_MOCK_LLM=true                 # set false AND provide LLM_API_KEY to use the real model
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
SIMULATE_LLM_OUTAGE=false           # S10: force the deterministic fallback planner

# Demo / safety toggles
FAULT_INJECTION_ENABLED=false       # S5: lets the UI inject an execution failure
SEED_ON_START=true
DEMO_RESET_ENABLED=true
SHOW_TEST_ACCOUNTS=true             # list reviewer accounts on the login page

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BCRYPT_ROUNDS=12
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_ROWS_PER_CALL=100
MAX_AGENT_TOOL_CALLS_PER_REQUEST=60
LOG_LEVEL=INFO
PORT=8000
